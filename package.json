{
  "name": "dahav",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "serve": "pocketbase serve --http=0.0.0.0:8090",
    "serve:dev": "pocketbase serve --http=0.0.0.0:8090 --dev",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "test:update": "node scripts/test-update.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.34.0",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.3.11",
    "pocketbase": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
